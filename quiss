<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Quiz GEH – Gastroenterohepatologi</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --blue:#2563eb;--blue2:#1e40af;--blue-l:#dbeafe;
  --green:#16a34a;--green-l:#dcfce7;
  --red:#dc2626;--red-l:#fee2e2;
  --amber:#d97706;--amber-l:#fef3c7;
  --gray50:#f8fafc;--gray100:#f1f5f9;--gray200:#e2e8f0;
  --gray400:#94a3b8;--gray600:#475569;--gray700:#334155;--gray900:#0f172a;
  --white:#fff;
  --r:10px;--rl:18px;--tr:.22s cubic-bezier(.4,0,.2,1);
  --sh:0 4px 16px rgba(0,0,0,.10);--shl:0 8px 32px rgba(0,0,0,.14);
}
html{font-size:16px;-webkit-tap-highlight-color:transparent}
body{font-family:'Segoe UI',system-ui,sans-serif;background:linear-gradient(135deg,#e0f2fe 0%,#ede9fe 100%);min-height:100vh;color:var(--gray900);line-height:1.6}
/* Screens */
.screen{display:none;min-height:100vh;flex-direction:column}
.screen.active{display:flex}
/* ---- START SCREEN ---- */
#startScreen{align-items:center;justify-content:center;padding:24px 16px}
.start-card{background:var(--white);border-radius:var(--rl);box-shadow:var(--shl);padding:40px 32px 36px;width:100%;max-width:480px;text-align:center}
.logo{font-size:58px;margin-bottom:8px}
.start-card h1{font-size:2rem;font-weight:800;color:var(--blue);letter-spacing:-.5px}
.subtitle{color:var(--gray600);font-size:.93rem;margin:4px 0 24px}
.meta-row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:24px}
.meta-chip{background:var(--blue-l);color:var(--blue2);border-radius:100px;padding:5px 14px;font-size:.8rem;font-weight:700}
.cfg{background:var(--gray50);border:1px solid var(--gray200);border-radius:var(--r);padding:18px 20px;margin-bottom:22px;text-align:left}
.cfg label{display:block;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--gray600);margin-bottom:5px;margin-top:14px}
.cfg label:first-child{margin-top:0}
.cfg select{width:100%;padding:9px 12px;border:1.5px solid var(--gray200);border-radius:6px;font-size:.95rem;background:var(--white);color:var(--gray900);cursor:pointer;outline:none;transition:border-color var(--tr)}
.cfg select:focus{border-color:var(--blue)}
.tog-row{display:flex;align-items:center;gap:12px;margin-top:4px}
.tog{position:relative;display:inline-block;width:46px;height:26px}
.tog input{opacity:0;width:0;height:0}
.sl{position:absolute;inset:0;background:var(--gray200);border-radius:100px;cursor:pointer;transition:background var(--tr)}
.sl::before{content:'';position:absolute;width:20px;height:20px;left:3px;top:3px;background:var(--white);border-radius:50%;transition:transform var(--tr);box-shadow:0 1px 3px rgba(0,0,0,.15)}
.tog input:checked+.sl{background:var(--blue)}
.tog input:checked+.sl::before{transform:translateX(20px)}
.tog-lbl{font-size:.9rem;color:var(--gray700);font-weight:600}
/* Buttons */
.btn-p{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--blue);color:var(--white);border:none;border-radius:8px;padding:13px 28px;font-size:1rem;font-weight:700;cursor:pointer;transition:background var(--tr),transform var(--tr),box-shadow var(--tr);box-shadow:0 2px 8px rgba(37,99,235,.30);width:100%}
.btn-p:hover{background:var(--blue2);box-shadow:0 4px 14px rgba(37,99,235,.40)}
.btn-p:active{transform:scale(.97)}
.btn-s{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--white);color:var(--blue);border:2px solid var(--blue);border-radius:8px;padding:11px 24px;font-size:.95rem;font-weight:700;cursor:pointer;transition:all var(--tr)}
.btn-s:hover{background:var(--blue-l)}
.btn-s:active{transform:scale(.97)}
.btn-ico{background:none;border:none;cursor:pointer;font-size:1.25rem;padding:6px 10px;border-radius:6px;color:var(--gray700);transition:background var(--tr)}
.btn-ico:hover{background:var(--gray100)}
/* ---- QUIZ SCREEN ---- */
#quizScreen{background:var(--gray50)}
.q-header{position:sticky;top:0;z-index:50;background:var(--white);border-bottom:1px solid var(--gray200);padding:10px 16px;display:flex;align-items:center;gap:12px;box-shadow:0 1px 4px rgba(0,0,0,.07)}
.h-left{display:flex;align-items:center;gap:8px;flex-shrink:0}
.h-right{flex-shrink:0}
.h-center{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px}
.q-title{font-size:.83rem;font-weight:700;color:var(--blue);white-space:nowrap}
.pb-wrap{width:100%;max-width:260px;height:7px;background:var(--gray200);border-radius:100px;overflow:hidden}
.pb-fill{height:100%;background:linear-gradient(90deg,var(--blue) 0%,#7c3aed 100%);border-radius:100px;transition:width .4s ease;width:0%}
.prog-txt{font-size:.7rem;color:var(--gray600);font-weight:600}
.score-badge{background:var(--green-l);color:var(--green);border-radius:100px;padding:4px 12px;font-size:.8rem;font-weight:700;white-space:nowrap}
.q-main{flex:1;padding:20px 16px 130px;display:flex;justify-content:center}
.q-card{background:var(--white);border-radius:var(--r);box-shadow:var(--sh);padding:28px 24px;width:100%;max-width:740px;animation:slideIn .25s ease}
@keyframes slideIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.q-num{font-size:.73rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);margin-bottom:10px;display:flex;align-items:center;gap:8px}
.q-num::after{content:'';flex:1;height:1.5px;background:var(--blue-l);border-radius:100px}
.q-txt{font-size:1rem;line-height:1.75;color:var(--gray900);margin-bottom:22px;font-weight:500}
.opts{display:flex;flex-direction:column;gap:9px}
.opt-btn{display:flex;align-items:flex-start;gap:12px;background:var(--white);border:2px solid var(--gray200);border-radius:8px;padding:12px 16px;text-align:left;cursor:pointer;font-size:.94rem;color:var(--gray900);transition:border-color var(--tr),background var(--tr),transform var(--tr);width:100%;line-height:1.55}
.opt-btn:hover:not(:disabled){border-color:var(--blue);background:var(--blue-l);transform:translateX(3px)}
.opt-lbl{min-width:28px;height:28px;background:var(--gray100);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:.76rem;flex-shrink:0;margin-top:1px;transition:background var(--tr),color var(--tr)}
.opt-btn.correct{border-color:var(--green);background:var(--green-l)}
.opt-btn.correct .opt-lbl{background:var(--green);color:var(--white)}
.opt-btn.wrong{border-color:var(--red);background:var(--red-l)}
.opt-btn.wrong .opt-lbl{background:var(--red);color:var(--white)}
.opt-btn.highlight{border-color:var(--green);background:var(--green-l)}
.opt-btn.highlight .opt-lbl{background:var(--green);color:var(--white)}
.opt-btn:disabled{cursor:default}
.exp-panel{margin-top:18px;border-radius:8px;padding:13px 16px;background:var(--gray50);border-left:4px solid var(--blue);animation:slideIn .25s ease}
.exp-panel.is-ok{border-left-color:var(--green);background:var(--green-l)}
.exp-panel.is-bad{border-left-color:var(--red);background:var(--red-l)}
.exp-head{display:flex;align-items:center;gap:8px;margin-bottom:5px;font-size:.88rem}
.exp-head strong{font-weight:800}
.exp-body{font-size:.86rem;color:var(--gray700);line-height:1.6}
/* Footer */
.q-footer{position:fixed;bottom:0;left:0;right:0;background:var(--white);border-top:1px solid var(--gray200);padding:10px 16px;display:flex;align-items:center;gap:10px;box-shadow:0 -2px 10px rgba(0,0,0,.07);z-index:40}
.q-footer .btn-s,.q-footer .btn-p{width:auto;min-width:90px;flex-shrink:0;padding:10px 16px;font-size:.86rem}
.dot-nav{flex:1;display:flex;align-items:center;justify-content:center;gap:4px;overflow:hidden}
.dot{width:8px;height:8px;border-radius:50%;background:var(--gray200);flex-shrink:0;transition:all var(--tr);cursor:pointer}
.dot.cur{background:var(--blue);transform:scale(1.45)}
.dot.ok{background:var(--green)}
.dot.bad{background:var(--red)}
/* ---- SIDE MENU ---- */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:100;backdrop-filter:blur(2px)}
.overlay.vis{display:block}
.side{position:fixed;top:0;left:0;bottom:0;width:300px;background:var(--white);box-shadow:var(--shl);z-index:110;display:flex;flex-direction:column;transform:translateX(-100%);transition:transform var(--tr)}
.side.open{transform:translateX(0)}
.side-hd{display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--gray200);font-weight:700;font-size:.93rem}
.side-leg{display:flex;flex-wrap:wrap;gap:8px;padding:10px 16px;border-bottom:1px solid var(--gray200);font-size:.72rem;font-weight:700}
.leg-ok{color:var(--green)}.leg-bad{color:var(--red)}.leg-new{color:var(--gray400)}.leg-cur{color:var(--blue)}
.side-grid{flex:1;overflow-y:auto;padding:12px 16px;display:grid;grid-template-columns:repeat(6,1fr);gap:6px;align-content:start}
.sn{width:38px;height:38px;border-radius:6px;font-size:.76rem;font-weight:700;border:2px solid var(--gray200);background:var(--white);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--tr);color:var(--gray700)}
.sn:hover{border-color:var(--blue);color:var(--blue)}
.sn.cur{border-color:var(--blue);background:var(--blue);color:var(--white)}
.sn.ok{border-color:var(--green);background:var(--green-l);color:var(--green)}
.sn.bad{border-color:var(--red);background:var(--red-l);color:var(--red)}
.btn-fin{margin:12px 16px 16px;background:var(--red);color:var(--white);border:none;border-radius:8px;padding:13px;font-size:.93rem;font-weight:700;cursor:pointer;transition:background var(--tr)}
.btn-fin:hover{background:#b91c1c}
/* ---- RESULT SCREEN ---- */
#resultScreen{align-items:center;justify-content:center;padding:24px 16px;background:linear-gradient(135deg,#e0f2fe 0%,#ede9fe 100%)}
.res-card{background:var(--white);border-radius:var(--rl);box-shadow:var(--shl);padding:36px 28px 32px;width:100%;max-width:460px;text-align:center}
.trophy{font-size:62px;margin-bottom:8px;animation:bounce .65s ease}
@keyframes bounce{0%,100%{transform:translateY(0)}40%{transform:translateY(-18px)}70%{transform:translateY(-8px)}}
.res-card h2{font-size:1.55rem;font-weight:800;margin-bottom:6px}
.res-sub{color:var(--gray600);margin-bottom:24px;font-size:.93rem}
.ring-wrap{position:relative;width:148px;height:148px;margin:0 auto 24px}
.ring-wrap svg{transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--gray200);stroke-width:10}
.ring-fg{fill:none;stroke:var(--blue);stroke-width:10;stroke-linecap:round;transition:stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1)}
.ring-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.75rem;font-weight:900;color:var(--blue)}
.stat-row{display:flex;gap:10px;justify-content:center;margin-bottom:24px}
.stat-box{flex:1;border-radius:var(--r);padding:14px 8px;display:flex;flex-direction:column;align-items:center;gap:3px}
.stat-box.ok{background:var(--green-l)}.stat-box.bad{background:var(--red-l)}.stat-box.skip{background:var(--amber-l)}
.stat-n{font-size:1.55rem;font-weight:900}
.stat-box.ok .stat-n{color:var(--green)}.stat-box.bad .stat-n{color:var(--red)}.stat-box.skip .stat-n{color:var(--amber)}
.stat-l{font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--gray600)}
.res-acts{display:flex;flex-direction:column;gap:10px}
/* ---- REVIEW SCREEN ---- */
#reviewScreen{background:var(--gray50)}
.rev-hd{position:sticky;top:0;background:var(--white);border-bottom:1px solid var(--gray200);padding:12px 16px;z-index:50;box-shadow:0 1px 4px rgba(0,0,0,.07)}
.rev-hd h2{font-size:1rem;font-weight:800;margin:6px 0;color:var(--gray900)}
.rev-filters{display:flex;gap:6px;flex-wrap:wrap}
.f-btn{padding:5px 14px;border-radius:100px;border:1.5px solid var(--gray200);background:var(--white);font-size:.78rem;font-weight:700;cursor:pointer;transition:all var(--tr);color:var(--gray700)}
.f-btn.active{background:var(--blue);color:var(--white);border-color:var(--blue)}
.rev-list{padding:16px;display:flex;flex-direction:column;gap:14px;max-width:760px;margin:0 auto;padding-bottom:40px}
.rev-item{background:var(--white);border-radius:var(--r);box-shadow:0 1px 4px rgba(0,0,0,.07);overflow:hidden;border-left:5px solid var(--gray200)}
.rev-item.ok{border-left-color:var(--green)}.rev-item.bad{border-left-color:var(--red)}.rev-item.skip{border-left-color:var(--amber)}
.rev-head{display:flex;align-items:center;gap:8px;padding:12px 16px 10px;cursor:pointer;user-select:none}
.rev-badge{font-size:.7rem;font-weight:800;border-radius:100px;padding:3px 9px;flex-shrink:0}
.ok .rev-badge{background:var(--green-l);color:var(--green)}.bad .rev-badge{background:var(--red-l);color:var(--red)}.skip .rev-badge{background:var(--amber-l);color:var(--amber)}
.rev-qn{font-size:.7rem;color:var(--gray400);font-weight:700;flex-shrink:0}
.rev-qt{font-size:.86rem;color:var(--gray900);line-height:1.45;flex:1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.rev-chev{font-size:.85rem;color:var(--gray400);transition:transform var(--tr);flex-shrink:0}
.rev-head.open .rev-chev{transform:rotate(180deg)}
.rev-body{padding:0 16px 14px;display:none}
.rev-body.open{display:block;animation:slideIn .2s ease}
.rev-full{font-size:.88rem;line-height:1.65;color:var(--gray700);margin-bottom:10px;padding-top:4px}
.rev-opts{display:flex;flex-direction:column;gap:6px}
.rev-opt{display:flex;align-items:flex-start;gap:8px;padding:8px 12px;border-radius:6px;font-size:.84rem;background:var(--gray50);border:1.5px solid transparent;line-height:1.5}
.rev-opt.is-ans{background:var(--green-l);border-color:var(--green);font-weight:700}.rev-opt.is-wrong{background:var(--red-l);border-color:var(--red)}
.rev-opt-lbl{min-width:22px;height:22px;border-radius:50%;background:var(--gray200);display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:800;flex-shrink:0}
.rev-opt.is-ans .rev-opt-lbl{background:var(--green);color:var(--white)}.rev-opt.is-wrong .rev-opt-lbl{background:var(--red);color:var(--white)}
/* scrollbar */
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:var(--gray100)}::-webkit-scrollbar-thumb{background:var(--gray200);border-radius:100px}
/* responsive */
@media(max-width:480px){
  .start-card{padding:24px 18px 26px}
  .start-card h1{font-size:1.6rem}
  .q-card{padding:18px 14px}
  .q-txt{font-size:.92rem}
  .opt-btn{font-size:.87rem;padding:10px 12px}
  .side{width:100%}
  .q-footer .btn-s,.q-footer .btn-p{min-width:76px;padding:9px 10px;font-size:.8rem}
}
@media(min-width:768px){
  .q-main{padding:28px 24px 130px}
  .q-txt{font-size:1.04rem}
}
</style>
</head>
<body>

<!-- START SCREEN -->
<div id="startScreen" class="screen active">
  <div class="start-card">
    <div class="logo">🩺</div>
    <h1>Quiz GEH</h1>
    <p class="subtitle">Gastroenterohepatologi</p>
    <div class="meta-row">
      <span class="meta-chip" id="totalLbl">0 soal</span>
      <span class="meta-chip">⏱ Tanpa batas waktu</span>
      <span class="meta-chip">🎯 Pilihan ganda</span>
    </div>
    <div class="cfg">
      <label for="modeSelect">Mode Quiz</label>
      <select id="modeSelect">
        <option value="all">Semua Soal (Acak)</option>
        <option value="50">50 Soal Acak</option>
        <option value="100">100 Soal Acak</option>
        <option value="seq">Semua Soal (Berurutan)</option>
      </select>
      <label>Tampilkan jawaban benar setelah menjawab</label>
      <div class="tog-row">
        <label class="tog"><input type="checkbox" id="chkExplain" checked/><span class="sl"></span></label>
        <span class="tog-lbl" id="explainLbl">Aktif</span>
      </div>
    </div>
    <button class="btn-p" id="btnStart">▶ Mulai Quiz</button>
  </div>
</div>

<!-- QUIZ SCREEN -->
<div id="quizScreen" class="screen">
  <header class="q-header">
    <div class="h-left">
      <button class="btn-ico" id="btnMenu" title="Navigasi">☰</button>
      <span class="q-title">Quiz GEH</span>
    </div>
    <div class="h-center">
      <div class="pb-wrap"><div class="pb-fill" id="pbFill"></div></div>
      <span class="prog-txt" id="progTxt">1 / 1</span>
    </div>
    <div class="h-right">
      <span class="score-badge">✅ <span id="scoreNum">0</span></span>
    </div>
  </header>

  <main class="q-main">
    <div class="q-card" id="qCard">
      <div class="q-num" id="qNum">Soal 1</div>
      <p class="q-txt" id="qTxt"></p>
      <div class="opts" id="optsGrid"></div>
      <div class="exp-panel" id="expPanel" style="display:none">
        <div class="exp-head"><span id="expIcon"></span><strong id="expTitle"></strong></div>
        <p class="exp-body" id="expBody"></p>
      </div>
    </div>
  </main>

  <footer class="q-footer">
    <button class="btn-s" id="btnPrev">‹ Sebelumnya</button>
    <div class="dot-nav" id="dotNav"></div>
    <button class="btn-p" id="btnNext">Selanjutnya ›</button>
  </footer>
</div>

<!-- RESULT SCREEN -->
<div id="resultScreen" class="screen">
  <div class="res-card">
    <div class="trophy" id="trophy">🏆</div>
    <h2 id="resTitle">Selesai!</h2>
    <p class="res-sub" id="resSub"></p>
    <div class="ring-wrap">
      <svg viewBox="0 0 120 120" width="148" height="148">
        <circle class="ring-bg" cx="60" cy="60" r="50"/>
        <circle class="ring-fg" id="ringFg" cx="60" cy="60" r="50"
                stroke-dasharray="314" stroke-dashoffset="314"/>
      </svg>
      <div class="ring-num" id="ringNum">0%</div>
    </div>
    <div class="stat-row">
      <div class="stat-box ok"><span class="stat-n" id="stOk">0</span><span class="stat-l">Benar</span></div>
      <div class="stat-box bad"><span class="stat-n" id="stBad">0</span><span class="stat-l">Salah</span></div>
      <div class="stat-box skip"><span class="stat-n" id="stSkip">0</span><span class="stat-l">Dilewati</span></div>
    </div>
    <div class="res-acts">
      <button class="btn-p" id="btnReview">📖 Tinjau Jawaban</button>
      <button class="btn-s" id="btnRestart">🔄 Quiz Baru</button>
    </div>
  </div>
</div>

<!-- REVIEW SCREEN -->
<div id="reviewScreen" class="screen">
  <header class="rev-hd">
    <button class="btn-ico" id="btnBackRev">← Kembali</button>
    <h2>Tinjau Jawaban</h2>
    <div class="rev-filters">
      <button class="f-btn active" data-f="all">Semua</button>
      <button class="f-btn" data-f="ok">✅ Benar</button>
      <button class="f-btn" data-f="bad">❌ Salah</button>
      <button class="f-btn" data-f="skip">⏭ Dilewati</button>
    </div>
  </header>
  <div class="rev-list" id="revList"></div>
</div>

<!-- OVERLAY + SIDE MENU -->
<div class="overlay" id="overlay"></div>
<aside class="side" id="sideMenu">
  <div class="side-hd">
    <span>📋 Navigasi Soal</span>
    <button class="btn-ico" id="btnCloseMenu">✕</button>
  </div>
  <div class="side-leg">
    <span class="leg-ok">■ Benar</span>
    <span class="leg-bad">■ Salah</span>
    <span class="leg-new">■ Belum dijawab</span>
    <span class="leg-cur">■ Aktif</span>
  </div>
  <div class="side-grid" id="sideGrid"></div>
  <button class="btn-fin" id="btnFinish">🏁 Selesai & Lihat Nilai</button>
</aside>
<script>
// =================== QUESTIONS DATA ===================
const questions = [
  {
    "question": "Glukokortikosteroid dapat digunakan untuk mengatasi peradangan pada IBD. Untuk mengatasi efek sampingnya dapat diganti dengan obat:",
    "options": [
      "Azathiopirin",
      "Sulfasalazine",
      "Anti TNF alpha",
      "Monoclonal antibody",
      "Methotrexate"
    ],
    "answer": "Azathiopirin"
  },
  {
    "question": "Seorang laki-laki berusia 47 tahun datang ke poli RS diantar istrinya dengan keluhan benjolan di anus. Keluhan ini sudah dirasakan pasien sejak kurang lebih 1 minggu ini. Benjolan dirasa pasien keluar terlebih dahulu sebelum keluar saat BAB. Biasanya disertai darah segar yang keluar setelah feses dan terasa nyeri. Benjolan dapat masuk secara spontan. Pasien jarang makan makanan berserat dan lebih banyak duduk dalam beraktivitas sehari-hari. Apa diagnosis yang paling mungkin pada pasien?",
    "options": [
      "Prolapse rekti",
      "Hemoroid grade 3-4",
