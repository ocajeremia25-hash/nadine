// =================== APP LOGIC ===================
(function(){
  // State
  var pool = [];
  var cur = 0;
  var answers = [];   // null | string
  var showExp = true;
  var isAnswered = false;

  // Dedup questions by text
  var seen = {};
  var uniqueQ = [];
  questions.forEach(function(q){
    var k = q.question.trim().toLowerCase();
    if(!seen[k]){ seen[k]=true; uniqueQ.push(q); }
  });

  // DOM helpers
  function ge(id){ return document.getElementById(id); }
  function qsa(sel){ return document.querySelectorAll(sel); }

  // ---- Screen management ----
  function showScreen(id){
    var screens = ['startScreen','quizScreen','resultScreen','reviewScreen'];
    screens.forEach(function(s){
      var el = ge(s);
      el.classList.remove('active');
      el.style.display = 'none';
    });
    var target = ge(id);
    target.style.display = 'flex';
    target.classList.add('active');
    window.scrollTo(0,0);
  }

  // ---- Shuffle ----
  function shuffle(arr){
    var a = arr.slice();
    for(var i=a.length-1;i>0;i--){
      var j=Math.floor(Math.random()*(i+1));
      var t=a[i]; a[i]=a[j]; a[j]=t;
    }
    return a;
  }

  // ---- Init ----
  window.addEventListener('load', function(){
    ge('totalLbl').textContent = uniqueQ.length + ' soal tersedia';

    ge('chkExplain').addEventListener('change', function(){
      ge('explainLbl').textContent = this.checked ? 'Aktif' : 'Nonaktif';
    });

    ge('btnStart').addEventListener('click', startQuiz);
    ge('btnPrev').addEventListener('click', function(){ goTo(cur-1); });
    ge('btnNext').addEventListener('click', function(){
      if(cur < pool.length-1) goTo(cur+1);
      else showResult();
    });

    ge('btnMenu').addEventListener('click', openMenu);
    ge('btnCloseMenu').addEventListener('click', closeMenu);
    ge('overlay').addEventListener('click', closeMenu);
    ge('btnFinish').addEventListener('click', function(){ closeMenu(); showResult(); });

    ge('btnReview').addEventListener('click', openReview);
    ge('btnRestart').addEventListener('click', function(){ showScreen('startScreen'); });
    ge('btnBackRev').addEventListener('click', function(){ showScreen('resultScreen'); });

    qsa('.f-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        qsa('.f-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        buildReview(btn.getAttribute('data-f'));
      });
    });

    // Show start screen properly
    showScreen('startScreen');
  });

  // ---- Start Quiz ----
  function startQuiz(){
    showExp = ge('chkExplain').checked;
    var mode = ge('modeSelect').value;

    var base = uniqueQ.slice();
    if(mode==='seq'){
      pool = base;
    } else if(mode==='all'){
      pool = shuffle(base);
    } else {
      var n = parseInt(mode);
      pool = shuffle(base).slice(0, Math.min(n, base.length));
    }

    answers = [];
    for(var i=0;i<pool.length;i++) answers.push(null);
    cur = 0;

    showScreen('quizScreen');
    renderQ();
  }

  // ---- Render Question ----
  function renderQ(){
    var q = pool[cur];
    isAnswered = answers[cur] !== null;
    var ua = answers[cur];

    // Progress
    var pct = Math.round(((cur+1)/pool.length)*100);
    ge('pbFill').style.width = pct+'%';
    ge('progTxt').textContent = (cur+1)+' / '+pool.length;

    // Score
    var sc = 0;
    for(var i=0;i<answers.length;i++){
      if(answers[i] !== null && answers[i] === pool[i].answer) sc++;
    }
    ge('scoreNum').textContent = sc;

    // Question text
    ge('qNum').textContent = 'Soal '+(cur+1);
    ge('qTxt').textContent = q.question;

    // Options
    var grid = ge('optsGrid');
    grid.innerHTML = '';
    var labels = ['A','B','C','D','E','F'];

    q.options.forEach(function(opt, i){
      var btn = document.createElement('button');
      btn.className = 'opt-btn';
      if(isAnswered) btn.disabled = true;

      var lbl = document.createElement('span');
      lbl.className = 'opt-lbl';
      lbl.textContent = labels[i] || String(i+1);

      var txt = document.createElement('span');
      txt.textContent = opt;
      txt.style.flex = '1';

      btn.appendChild(lbl);
      btn.appendChild(txt);

      if(isAnswered){
        if(opt === q.answer){
          btn.classList.add(ua === opt ? 'correct' : 'highlight');
        } else if(opt === ua){
          btn.classList.add('wrong');
        }
      }

      btn.addEventListener('click', function(){ selectAnswer(opt); });
      grid.appendChild(btn);
    });

    // Explanation
    var ep = ge('expPanel');
    ep.style.display = 'none';
    ep.className = 'exp-panel';

    if(isAnswered && showExp){
      var ok = ua === q.answer;
      ep.style.display = 'block';
      ep.classList.add(ok ? 'is-ok' : 'is-bad');
      ge('expIcon').textContent = ok ? '✅' : '❌';
      ge('expTitle').textContent = ok ? ' Jawaban Benar!' : ' Jawaban Salah!';
      ge('expBody').textContent = 'Jawaban yang benar: ' + q.answer;
    }

    // Buttons
    ge('btnPrev').disabled = (cur === 0);
    ge('btnNext').textContent = (cur === pool.length-1) ? '🏁 Selesai' : 'Selanjutnya ›';

    buildDots();
    buildSideGrid();
  }

  // ---- Select Answer ----
  function selectAnswer(opt){
    if(isAnswered) return;
    answers[cur] = opt;
    isAnswered = true;
    renderQ();
  }

  // ---- Navigate ----
  function goTo(idx){
    if(idx < 0 || idx >= pool.length) return;
    cur = idx;
    var card = ge('qCard');
    card.style.animation = 'none';
    setTimeout(function(){
      card.style.animation = '';
      renderQ();
    }, 10);
  }

  // ---- Dots ----
  function buildDots(){
    var nav = ge('dotNav');
    nav.innerHTML = '';
    var total = pool.length;
    var maxD = 11;
    var start = Math.max(0, cur - Math.floor(maxD/2));
    var end = Math.min(total, start + maxD);
    if(end - start < maxD) start = Math.max(0, end - maxD);

    for(var i=start;i<end;i++){
      var d = document.createElement('div');
      d.className = 'dot';
      if(i===cur) d.classList.add('cur');
      else if(answers[i]!==null){
        d.classList.add(answers[i]===pool[i].answer ? 'ok' : 'bad');
      }
      (function(idx){ d.addEventListener('click', function(){ goTo(idx); }); })(i);
      nav.appendChild(d);
    }
  }

  // ---- Side Grid ----
  function buildSideGrid(){
    var g = ge('sideGrid');
    g.innerHTML = '';
    pool.forEach(function(q, i){
      var btn = document.createElement('button');
      btn.className = 'sn';
      btn.textContent = i+1;
      if(i===cur) btn.classList.add('cur');
      else if(answers[i]!==null){
        btn.classList.add(answers[i]===pool[i].answer ? 'ok' : 'bad');
      }
      (function(idx){ btn.addEventListener('click', function(){ closeMenu(); goTo(idx); }); })(i);
      g.appendChild(btn);
    });
  }

  // ---- Menu ----
  function openMenu(){
    buildSideGrid();
    ge('sideMenu').classList.add('open');
    ge('overlay').classList.add('vis');
  }
  function closeMenu(){
    ge('sideMenu').classList.remove('open');
    ge('overlay').classList.remove('vis');
  }

  // ---- Result ----
  function showResult(){
    var total = pool.length;
    var correct = 0, skipped = 0;
    answers.forEach(function(a,i){
      if(a===null) skipped++;
      else if(a===pool[i].answer) correct++;
    });
    var wrong = total - correct - skipped;
    var pct = Math.round((correct/total)*100);

    var trophy='🥉', title='Terus Berlatih!';
    if(pct>=90){ trophy='🏆'; title='Luar Biasa! Sempurna!'; }
    else if(pct>=75){ trophy='🥇'; title='Hebat! Nilai Bagus!'; }
    else if(pct>=60){ trophy='🥈'; title='Cukup Baik! Tingkatkan Lagi!'; }

    ge('trophy').textContent = trophy;
    ge('resTitle').textContent = title;
    ge('resSub').textContent = 'Kamu menjawab '+correct+' dari '+total+' soal dengan benar.';
    ge('ringNum').textContent = pct+'%';
    ge('stOk').textContent = correct;
    ge('stBad').textContent = wrong;
    ge('stSkip').textContent = skipped;

    showScreen('resultScreen');

    // Animate ring
    setTimeout(function(){
      var offset = 314 - (pct/100)*314;
      var ring = ge('ringFg');
      ring.style.strokeDashoffset = offset;
      if(pct>=75) ring.style.stroke='#16a34a';
      else if(pct>=50) ring.style.stroke='#d97706';
      else ring.style.stroke='#dc2626';
    }, 100);
  }

  // ---- Review ----
  function openReview(){
    showScreen('reviewScreen');
    qsa('.f-btn').forEach(function(b){ b.classList.remove('active'); });
    document.querySelector('[data-f="all"]').classList.add('active');
    buildReview('all');
  }

  function buildReview(filter){
    var list = ge('revList');
    list.innerHTML = '';
    var labels = ['A','B','C','D','E','F'];

    pool.forEach(function(q, i){
      var ua = answers[i];
      var isOk = ua === q.answer;
      var isSkip = ua === null;
      var status = isSkip ? 'skip' : (isOk ? 'ok' : 'bad');

      if(filter==='ok' && status!=='ok') return;
      if(filter==='bad' && status!=='bad') return;
      if(filter==='skip' && status!=='skip') return;

      var item = document.createElement('div');
      item.className = 'rev-item '+status;

      var badge = status==='ok' ? '✅ Benar' : status==='bad' ? '❌ Salah' : '⏭ Dilewati';

      var optsHTML = q.options.map(function(opt, oi){
        var cls = '';
        if(opt===q.answer) cls='is-ans';
        else if(opt===ua) cls='is-wrong';
        return '<div class="rev-opt '+cls+'">'
          +'<span class="rev-opt-lbl">'+(labels[oi]||oi+1)+'</span>'
          +'<span>'+escHtml(opt)+'</span>'
          +'</div>';
      }).join('');

      item.innerHTML =
        '<div class="rev-head" data-open="0">'
          +'<span class="rev-qn">#'+(i+1)+'</span>'
          +'<span class="rev-badge">'+badge+'</span>'
          +'<span class="rev-qt">'+escHtml(q.question)+'</span>'
          +'<span class="rev-chev">▼</span>'
        +'</div>'
        +'<div class="rev-body">'
          +'<p class="rev-full">'+escHtml(q.question)+'</p>'
          +'<div class="rev-opts">'+optsHTML+'</div>'
        +'</div>';

      var head = item.querySelector('.rev-head');
      var body = item.querySelector('.rev-body');
      head.addEventListener('click', function(){
        var isOpen = head.getAttribute('data-open')==='1';
        head.setAttribute('data-open', isOpen?'0':'1');
        if(isOpen){ head.classList.remove('open'); body.classList.remove('open'); }
        else { head.classList.add('open'); body.classList.add('open'); }
      });

      list.appendChild(item);
    });

    if(list.children.length===0){
      list.innerHTML='<p style="text-align:center;color:#94a3b8;padding:48px 0">Tidak ada soal di kategori ini.</p>';
    }
  }

  function escHtml(s){
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

})();
</script>
</body>
</html>
